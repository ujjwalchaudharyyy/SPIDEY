# ===================================================
# SPIDEY-HUB Environment Configuration
# ===================================================

# Frontend Configuration (Vite)
# Copy to frontend/.env or set in Vercel project settings
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend Configuration (Node / Express)
# Copy to backend/.env or set on production server
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET=campus_event_hub_secret_2024

# Razorpay Payment Gateway (Test Mode / Live Mode)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE
